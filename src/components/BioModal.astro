---
import { band, members } from "../data/site";
---

<div
  id="bio-modal"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-night/75 p-4"
>
  <div class="relative max-w-lg rounded-lg border border-line bg-dusk p-8 shadow-[0_24px_64px_-16px_oklch(0.08_0.03_300/0.8)]">
    <button
      id="bio-close"
      aria-label="Close"
      class="absolute right-4 top-4 text-haze transition hover:text-cream"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <h2 class="mb-6 font-display text-xl font-light tracking-[0.32em] uppercase">{band.name}</h2>
    <p class="whitespace-pre-line text-mist">{band.bio}</p>
    <ul class="mt-6 space-y-1 border-t border-line pt-6 text-sm tracking-[0.14em] uppercase">
      {members.map((m) => <li>{m.name}</li>)}
    </ul>
  </div>
</div>

<script>
  const trigger = document.getElementById("bio-trigger");
  const modal = document.getElementById("bio-modal");
  const closeBtn = document.getElementById("bio-close");

  const open = () => modal?.classList.remove("hidden");
  const close = () => modal?.classList.add("hidden");

  trigger?.addEventListener("click", (e) => {
    e.preventDefault();
    modal?.classList.add("flex");
    open();
  });
  closeBtn?.addEventListener("click", close);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
