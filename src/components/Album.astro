---
import { album, tracks } from "../data/site";

const numberWords = ["One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"];
---

<section id="album" class="mx-auto max-w-5xl px-4 py-24">
  <h2 class="heading mb-14 text-center normal-case">{album.title}</h2>

  <div class="grid gap-14 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
    <blockquote
      class="whitespace-pre-line text-center text-lg leading-relaxed font-light text-mist md:sticky md:top-28 md:self-start md:text-left"
    >
      {album.poem}
    </blockquote>

    <ol class="divide-y divide-line border-y border-line">
      {tracks.map((track, i) => (
        <li>
          <details class="group">
            <summary class="flex cursor-pointer list-none items-baseline gap-4 py-4 transition hover:text-surf">
              <span class="w-14 shrink-0 text-right text-[0.65rem] font-semibold italic tracking-[0.18em] uppercase text-haze">
                {numberWords[i] ?? i + 1}
              </span>
              <span class="flex-1 text-lg tracking-wide">{track.title}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="size-4 shrink-0 self-center text-haze transition group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="pb-6 pl-18 text-sm text-mist">
              <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
                {track.credits.map((c) => (
                  <>
                    <dt class="font-semibold text-cream">{c.who}</dt>
                    <dd>{c.plays}</dd>
                  </>
                ))}
              </dl>
              <p class="mt-3 text-haze">Recorded at {track.recorded}</p>
              {track.lyrics && (
                <p class="mt-5 whitespace-pre-line leading-relaxed text-mist">{track.lyrics}</p>
              )}
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>

  <div class="mx-auto mt-16 max-w-2xl space-y-1 text-center text-sm text-haze">
    {album.credits.map((line) => <p>{line}</p>)}
    <p>
      {album.artwork.text}{" "}
      <a href={album.artwork.url} target="_blank" rel="noreferrer" class="text-mist underline decoration-line hover:text-cream hover:decoration-cream">
        {album.artwork.artist}
      </a>
    </p>
    <p class="pt-3">{album.thanks}</p>
    <p class="pt-3 tracking-[0.2em] uppercase text-xs">{album.label}</p>
  </div>
</section>
