---
import { signupFormAction } from "../data/site";
---

<section id="signup" class="mx-auto max-w-xl px-4 py-24 text-center">
  <h2 class="mb-4 heading">Sign Up</h2>
  <p class="mb-8 text-mist">Stay up to date with new music, tour dates, and news.</p>
  <form
    action={signupFormAction || undefined}
    method="post"
    target="_blank"
    class="flex flex-col gap-3 sm:flex-row"
  >
    <label for="email" class="sr-only">Email address</label>
    <input
      id="email"
      name="email"
      type="email"
      required
      placeholder="your@email.com"
      class="flex-1 rounded-full border border-cream/30 bg-transparent px-5 py-3 text-sm text-cream placeholder-haze outline-none focus:border-cream"
    />
    <button
      type="submit"
      class="rounded-full bg-cream px-6 py-3 text-sm font-semibold tracking-wide uppercase text-night transition hover:bg-surf"
    >
      Sign Up
    </button>
  </form>
  {!signupFormAction && (
    <p class="mt-4 text-xs text-haze">
      Wire this form up to a mailing list provider by setting `signupFormAction` in
      `src/data/site.ts`.
    </p>
  )}
</section>
