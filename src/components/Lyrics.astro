---
import { tracks } from "../data/site";
---

<section id="lyrics" class="mx-auto max-w-3xl px-4 py-24">
  <h2 class="mb-10 text-center font-display text-3xl font-bold tracking-widest uppercase">Lyrics</h2>
  <div class="divide-y divide-neutral-800 border-y border-neutral-800">
    {tracks.map((track) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between font-medium tracking-wide">
          {track.title}
          <span class="text-neutral-500 transition group-open:rotate-45">+</span>
        </summary>
        <pre class="mt-4 whitespace-pre-wrap font-sans text-sm text-neutral-400">{track.lyrics}</pre>
      </details>
    ))}
  </div>
</section>
