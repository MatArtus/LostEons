---
import "../styles/global.css";
import { band } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = band.name, description = band.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a0f24" />
    <!-- Icons: the large spire from the Common Absence cover. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/images/album-cover-2000.webp"
      imagesrcset="/images/album-cover-1200.webp 1200w, /images/album-cover-2000.webp 2000w"
      imagesizes="100vw"
    />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og.jpg" />
    <title>{title}</title>
  </head>
  <body class="bg-night text-cream antialiased">
    <!-- Fixed backdrop: the album's back illustration sits behind every section. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0">
      <img
        src="/images/album-back-1600.webp"
        srcset="/images/album-back-1000.webp 1000w, /images/album-back-1600.webp 1600w"
        sizes="100vw"
        alt=""
        decoding="async"
        class="h-full w-full object-cover object-[center_65%]"
      />
      <div
        class="absolute inset-0 bg-night/[0.78]"
      >
      </div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
