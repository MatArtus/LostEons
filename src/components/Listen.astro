---
import { band, streamingLink, orderLink } from "../data/site";

const platforms = [
  { name: "Spotify", href: band.social.spotify },
  { name: "Apple Music", href: band.social.appleMusic },
  { name: "Bandcamp", href: band.social.bandcamp },
];
---

<section id="listen" class="mx-auto max-w-3xl px-4 py-24 text-center">
  <h2 class="mb-6 font-display text-3xl font-bold tracking-widest uppercase">Listen & Order</h2>
  <div class="mb-8 flex flex-wrap justify-center gap-3">
    {platforms.map((p) => (
      <a
        href={p.href}
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-neutral-700 px-5 py-2 text-sm font-medium transition hover:border-white"
      >
        {p.name}
      </a>
    ))}
  </div>
  <div class="flex flex-wrap justify-center gap-4">
    <a
      href={streamingLink}
      target="_blank"
      rel="noreferrer"
      class="rounded-full bg-white px-6 py-3 text-sm font-semibold tracking-wide uppercase text-black transition hover:bg-neutral-200"
    >
      Stream the latest release
    </a>
    <a
      href={orderLink}
      target="_blank"
      rel="noreferrer"
      class="rounded-full border border-neutral-600 px-6 py-3 text-sm font-semibold tracking-wide uppercase transition hover:border-white"
    >
      Order merch / vinyl
    </a>
  </div>
</section>
