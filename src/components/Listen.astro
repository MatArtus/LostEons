---
import { band, streamingLink, orderLink } from "../data/site";
import PlatformIcon from "./PlatformIcon.astro";

const platforms = [
  { name: "Spotify", href: band.social.spotify },
  { name: "Deezer", href: band.social.deezer },
  { name: "Bandcamp", href: band.social.bandcamp },
  { name: "Apple Music", href: band.social.appleMusic },
].filter((p) => p.href);
---

<section id="listen" class="mx-auto max-w-3xl px-4 py-24 text-center">
  <h2 class="mb-6 heading">Listen & Order</h2>
  <div class="mb-8 flex flex-wrap justify-center gap-3">
    {platforms.map((p) => (
      <a
        href={p.href}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-cream/30 py-2 pr-5 pl-4 text-sm font-medium transition hover:border-cream"
      >
        <PlatformIcon name={p.name} class="size-4" />
        {p.name}
      </a>
    ))}
  </div>
  <div class="flex flex-wrap justify-center gap-4">
    <a
      href={streamingLink}
      target="_blank"
      rel="noreferrer"
      class="rounded-full bg-cream px-6 py-3 text-sm font-semibold tracking-wide uppercase text-night transition hover:bg-surf"
    >
      Stream the latest release
    </a>
    <a
      href={orderLink}
      target="_blank"
      rel="noreferrer"
      class="rounded-full border border-cream/45 px-6 py-3 text-sm font-semibold tracking-wide uppercase transition hover:border-cream"
    >
      Order merch / vinyl
    </a>
  </div>
</section>
