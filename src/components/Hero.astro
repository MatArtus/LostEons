---
import { band } from "../data/site";
---

<section id="top" class="flex min-h-[80vh] flex-col items-center justify-center gap-6 px-4 text-center">
  <h1 class="font-display text-5xl font-black tracking-widest uppercase sm:text-7xl">
    {band.name}
  </h1>
  <p class="max-w-xl text-lg text-neutral-400">{band.tagline}</p>
  <div class="flex gap-4">
    <a
      href="#listen"
      class="rounded-full bg-white px-6 py-3 text-sm font-semibold tracking-wide uppercase text-black transition hover:bg-neutral-200"
    >
      Listen Now
    </a>
    <a
      href="#live"
      class="rounded-full border border-neutral-600 px-6 py-3 text-sm font-semibold tracking-wide uppercase transition hover:border-white"
    >
      Tour Dates
    </a>
  </div>
</section>
