---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Listen from "../components/Listen.astro";
import Watch from "../components/Watch.astro";
import Album from "../components/Album.astro";
import Discography from "../components/Discography.astro";
import Live from "../components/Live.astro";
import SignUp from "../components/SignUp.astro";
import BioModal from "../components/BioModal.astro";
import Footer from "../components/Footer.astro";
import { sections } from "../data/site";
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Listen />
    <Album />
    <Discography />
    {sections.watch && <Watch />}
    {sections.live && <Live />}
    <SignUp />
  </main>
  <Footer />
  <BioModal />
</Layout>
